{
  "name": "shield",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n srv,web -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "node server/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
